# Build output. Reproducible from the committed sources, and the build
# directory alone is ~1.3 GB.
build/*
build-cmake/
package/
*.log
*.obj
*.pdb
*.ilk
*.lib
*.exp
*.exe

# force_keep is ACCUMULATED STATE that cannot be regenerated, so it is kept even
# though it lives under build/. See "Traps" in AGENTS.md.
!build/force_keep*

# The game's code and its audio microcode, recompiled from your ROM when you
# build (README "Building"). Upstream commits them; this fork commits nothing
# derived from the ROM. See README "What Is Not Committed, and Why".
RecompiledFuncs/
rsp/

# lib/ holds the dependencies as git submodules (see .gitmodules), so it must
# not be ignored.

# Python bytecode from the tools.
__pycache__/
*.pyc

# The web page's build (BUILDING.md, "The web page"), inside the checkout for ccache
build-web*/
